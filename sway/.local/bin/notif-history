#!/bin/sh
# Notification history picker on top of dunst.
#   notif-history          open fuzzel picker, selected entry is re-displayed
#   notif-history status   waybar json: count + paused state
#   notif-history clear    drop the whole history

entries() {
    dunstctl history | jq -r '
        .data[0][]
        | [ (.id.data | tostring),
            ( ( (.appname.data // "") | if . == "" then "" else . + ": " end )
              + ((.summary.data // "") | gsub("<[^>]*>"; ""))
              + ( (.body.data // "") | gsub("<[^>]*>"; "") | gsub("\\s+"; " ")
                  | if . == "" then "" else " — " + . end ) )
          ]
        | @tsv'
}

case "$1" in
status)
    n=$(dunstctl history | jq '.data[0] | length')
    [ "$(dunstctl is-paused)" = true ] && label="DND $n" || label="NOTI $n"
    tt=$(entries | cut -f2- | sed 's/^/• /' | head -15)
    [ -n "$tt" ] || tt="no notifications"
    jq -cn --arg text "$label" --arg tt "$tt" '{text:$text, tooltip:($tt | @html)}'
    ;;
clear)
    dunstctl history-clear
    ;;
*)
    list=$(entries)
    [ -n "$list" ] || { notify-send -t 1500 "Notification history is empty"; exit 0; }

    sel=$(printf '%s\n' "$list" | cut -f2- | fuzzel --dmenu --width 100 --prompt 'notif> ')
    [ -n "$sel" ] || exit 0

    id=$(printf '%s\n' "$list" | awk -F'\t' -v s="$sel" '$2 == s { print $1; exit }')
    [ -n "$id" ] && dunstctl history-pop "$id"
    ;;
esac
